---
import TinaMarkdown from "@tinacms/astro/TinaMarkdown.astro"
import { tinaField } from "@tinacms/astro/tina-field"
import type { ArticleQuery } from "../../tina/__generated__/types"
import { displayDate } from "../lib/content"
import { tagUrl } from "../lib/paths"
interface Props {
  data: ArticleQuery["article"]
}
const { data } = Astro.props
---

<header class="article-header">
  <h1 data-tina-field={tinaField(data, "title")}>{data.title || data._sys.filename}</h1>
  {data.date && (
    <time data-tina-field={tinaField(data, "date")} datetime={data.date}>
      {displayDate(data.date)}
    </time>
  )}
  <div class="tags" data-tina-field={tinaField(data, "tags")}>
    {data.tags?.map((tag) => tag && <a href={tagUrl(tag)}>#{tag}</a>)}
  </div>
</header>
<div class="prose" data-tina-field={tinaField(data, "body")}>
  <TinaMarkdown content={data.body} />
</div>
