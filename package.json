{
  "name": "hitochan777-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"node scripts/dev.mjs\"",
    "build": "tinacms build && astro build",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "check": "astro check",
    "test": "node --import tsx --test tests/migration.test.ts",
    "format": "prettier --write src tina/config.ts tests scripts astro.config.mjs package.json tsconfig.json",
    "verify:migration": "node --import tsx --test tests/preservation.test.ts",
    "test:smoke": "node --import tsx scripts/smoke.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vercel": "^11.0.20",
    "@tinacms/astro": "^0.8.0",
    "astro": "^7.2.8",
    "gray-matter": "^4.0.3",
    "github-slugger": "^2.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "tinacms": "^3.15.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "katex": "^0.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tinacms/cli": "^4.0.4",
    "@types/node": "^22.13.12",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
